<UserControl x:Class="ClinicManagement.UI.Views.Components.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:services="clr-namespace:ClinicManagement.UI.Services"
             mc:Ignorable="d" 
             d:DesignHeight="600">

    <Border Background="{StaticResource SidebarBrush}" 
            VerticalAlignment="Stretch"
            CornerRadius="14,14,14,14" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="0,0,1,0">

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="35"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="35" Height="35" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" Fill="{StaticResource CardBrush}" VerticalAlignment="Top"/>

                <Grid Grid.Column="1" Margin="8,3,5,0" VerticalAlignment="Top">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding UserName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    <TextBlock Grid.Row="1" Text="{Binding UserRole}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </Grid>

            <Button Grid.Column="2" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" FontSize="16" Cursor="Hand" Content="🏠"
                Command="{Binding NavigationCommand}" 
                CommandParameter="Dashboard" />
        </Grid>

            <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,25,0,0">

                <Button Content="Danh sách khám" HorizontalAlignment="Stretch"
                        Command="{Binding NavigationCommand}" CommandParameter="PatientList">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SidebarMenuButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Static services:AppState.Instance}, Path=CurrentUserRole}" Value="Kế Toán">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Tra cứu" HorizontalAlignment="Stretch"
                        Command="{Binding NavigationCommand}" CommandParameter="PatientLookup">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SidebarMenuButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Static services:AppState.Instance}, Path=CurrentUserRole}" Value="Kế Toán">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Lập hóa đơn" HorizontalAlignment="Stretch"
        Command="{Binding NavigationCommand}" CommandParameter="Invoice">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SidebarMenuButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Static services:AppState.Instance}, Path=CurrentUserRole}" Value="Tiếp Tân">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Source={x:Static services:AppState.Instance}, Path=CurrentUserRole}" Value="Kế Toán">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Lập báo cáo" HorizontalAlignment="Stretch"
                        Command="{Binding NavigationCommand}" CommandParameter="Report">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SidebarMenuButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Static services:AppState.Instance}, Path=CurrentUserRole}" Value="Tiếp Tân">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Source={x:Static services:AppState.Instance}, Path=CurrentUserRole}" Value="Bác Sĩ">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Cập nhật quy định" HorizontalAlignment="Stretch"
                        Command="{Binding NavigationCommand}" CommandParameter="Update">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SidebarMenuButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Static services:AppState.Instance}, Path=CurrentUserRole}" Value="Tiếp Tân">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Source={x:Static services:AppState.Instance}, Path=CurrentUserRole}" Value="Kế Toán">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Source={x:Static services:AppState.Instance}, Path=CurrentUserRole}" Value="Bác Sĩ">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <Button Grid.Row="2" Style="{StaticResource SidebarMenuButton}" Content="Đăng xuất" Foreground="Red" Margin="0,20,0,0" HorizontalAlignment="Stretch"
                    Command="{Binding LogoutCommand}"/>
        </Grid>
    </Border>
</UserControl>