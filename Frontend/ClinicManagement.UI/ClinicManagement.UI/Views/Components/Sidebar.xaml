<UserControl x:Class="ClinicManagement.UI.Views.Components.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="220">
    <Grid>
        <Border Background="{StaticResource SidebarBrush}" CornerRadius="15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Width="40" Height="40" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" Fill="{StaticResource CardBrush}" VerticalAlignment="Top"/>

                    <StackPanel Grid.Column="1" Margin="8,8,0,0">
                        <TextBlock Text="{Binding UserName}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock Text="{Binding UserRole}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="2" Width="28" Height="28" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" FontSize="20" Cursor="Hand" Content="🏠"
                            Command="{Binding NavigationCommand}" 
                            CommandParameter="Dashboard"/>
                </Grid>

                <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,40,0,0">

                    <Button Style="{StaticResource SidebarMenuButton}" Content="Danh sách khám"
                            Command="{Binding NavigationCommand}" 
                            CommandParameter="PatientList"/>

                    <Button Style="{StaticResource SidebarMenuButton}" Content="Tra cứu"
                            Command="{Binding NavigationCommand}" 
                            CommandParameter="PatientLookup"/>

                    <Button Style="{StaticResource SidebarMenuButton}" Content="Lập hóa đơn"
                            Command="{Binding NavigationCommand}" 
                            CommandParameter="Invoice"/>

                    <Button Style="{StaticResource SidebarMenuButton}" Content="Lập báo cáo"
                            Command="{Binding NavigationCommand}" 
                            CommandParameter="Report"/>

                    <Button Style="{StaticResource SidebarMenuButton}" Content="Cập nhật quy định"
                            Command="{Binding NavigationCommand}" 
                            CommandParameter="Update"/>
                </StackPanel>

                <Button Grid.Row="2" Style="{StaticResource SidebarMenuButton}" Content="Đăng xuất" Foreground="Red" Margin="0,20,0,0"
                        Command="{Binding LogoutCommand}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>