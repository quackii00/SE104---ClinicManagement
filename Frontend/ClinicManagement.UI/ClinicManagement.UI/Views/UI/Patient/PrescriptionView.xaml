<UserControl x:Class="ClinicManagement.UI.Views.UI.Patient.PrescriptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:components="clr-namespace:ClinicManagement.UI.Views.Components"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="800">

    <Grid Margin="10">
        <Border BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="15"
                Background="{StaticResource CardBrush}"
                Padding="15">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Phiếu khám bệnh"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="Họ tên" Opacity="0.8" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PatientName, Mode=OneWay}" IsReadOnly="True" Background="Transparent" VerticalContentAlignment="Center" Height="26" Margin="0,0,0,10"/>

                        <TextBlock Text="Ngày khám" Opacity="0.8" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NgayKhamText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Height="26"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="15,0,0,0">
                        <TextBlock Text="Triệu chứng" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding TrieuChung, UpdateSourceTrigger=PropertyChanged}" 
                                 IsReadOnly="{Binding IsReadOnly}"
                                 VerticalContentAlignment="Center" 
                                 Height="26" 
                                 Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.ColumnSpan="2">
                                <TextBlock Text="Chẩn đoán loại bệnh" Margin="0,0,0,4"/>

                                <ComboBox Height="26"
                                          ItemsSource="{Binding DanhSachLoaiBenh}"
                                          DisplayMemberPath="TenLoaiBenh" 
                                          SelectedValuePath="MaLoaiBenh"
                                          IsEnabled="{Binding IsEditable}"
                                          SelectedValue="{Binding BenhDuocChanDoan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Separator Grid.Row="2" Margin="0,5" BorderBrush="{StaticResource BorderBrush}"/>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Đơn thuốc"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,10"
                               Foreground="DeepSkyBlue"/>

                    <Grid Grid.Row="1" Margin="10,0,10,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="35"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Thuốc" FontWeight="Bold" Opacity="0.7"/>
                        <TextBlock Grid.Column="1" Text="Đơn vị" FontWeight="Bold" HorizontalAlignment="Center" Opacity="0.7"/>
                        <TextBlock Grid.Column="2" Text="Số lượng" FontWeight="Bold" HorizontalAlignment="Center" Opacity="0.7"/>
                        <TextBlock Grid.Column="3" Text="Cách dùng" FontWeight="Bold" Margin="10,0,0,0" Opacity="0.7"/>
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,5">
                        <ItemsControl ItemsSource="{Binding ToaThuocDangKe}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <components:MedicineRow IsEnabled="{Binding IsRowEnabled}" Margin="0,0,0,6"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="3" 
                            Content="+ Thêm thuốc"
                            Width="110"
                            Height="26"
                            Margin="5,5,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource CancelButton}"
                            Visibility="{Binding AddButtonVisibility}"
                            Command="{Binding ThemThuocCommand}"/>
                </Grid>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,15,0,0">

                    <Button Content="Hoàn tất"
                            Width="100"
                            Height="32"
                            Margin="10,0"
                            Style="{StaticResource PrimaryButton}"
                            Visibility="{Binding AddButtonVisibility}"
                            Command="{Binding HoanTatKhamCommand}"/>

                    <Button Content="Quay lại"
                            Width="100"
                            Height="32"
                            Margin="10,0"
                            Style="{StaticResource CancelButton}"
                            Command="{Binding HuyKhamCommand}"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>