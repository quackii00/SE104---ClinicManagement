<UserControl x:Class="ClinicManagement.UI.Views.UI.Patient.RecievePatient"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClinicManagement.UI.Views.UI.Patient"
             xmlns:components="clr-namespace:ClinicManagement.UI.Views.Components"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">
    <Grid>
        <Border BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="15" 
                Background="{StaticResource CardBrush}">
            <Grid>
                <Grid Margin="50,40">
                    <StackPanel Width="350" HorizontalAlignment="Center">

                        <TextBlock Text="Tiếp nhận bệnh nhân"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,35"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Số điện thoại" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding SoDienThoai, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     Height="28"/>
                            <Button Grid.Column="1"
                                    Content="Tìm"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="70"
                                    Height="28"
                                    Margin="8,0,0,0"
                                    Command="{Binding TimBenhNhanCommand}"/>
                        </Grid>

                        <TextBlock Text="Họ tên" Margin="0,20,0,5"/>
                        <TextBox Text="{Binding HoTen, UpdateSourceTrigger=PropertyChanged}" 
                                 VerticalContentAlignment="Center" 
                                 Height="28"/>

                        <TextBlock Text="Giới tính" Margin="0,20,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Nam" IsChecked="{Binding IsNam}" Margin="10,0"/>
                            <RadioButton Content="Nữ" IsChecked="{Binding IsNu}" Margin="25,0"/>
                        </StackPanel>

                        <TextBlock Text="Năm sinh" Margin="0,20,0,5"/>
                        <TextBox Text="{Binding NgaySinhText, UpdateSourceTrigger=PropertyChanged}" 
                                 ToolTip="Định dạng: dd/MM/yyyy hoặc yyyy" 
                                 VerticalContentAlignment="Center" 
                                 Height="28"/>

                        <TextBlock Text="Địa chỉ" Margin="0,20,0,5"/>
                        <TextBox Text="{Binding DiaChi, UpdateSourceTrigger=PropertyChanged}" 
                                 VerticalContentAlignment="Center" 
                                 Height="28"/>

                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center" 
                                    Margin="0,45,0,0">
                            <Button Content="Thêm" 
                                    Style="{StaticResource PrimaryButton}" 
                                    Margin="15,0" 
                                    Width="90" 
                                    Height="32"
                                    Command="{Binding ThemCommand}"/>
                            <Button Content="Hủy" 
                                    Style="{StaticResource CancelButton}" 
                                    Margin="15,0" 
                                    Width="90" 
                                    Height="32"
                                    Command="{Binding HuyCommand}"/>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>