<UserControl x:Class="ClinicManagement.UI.Views.UI.Patient.RecievePatient"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClinicManagement.UI.Views.UI.Patient"
             xmlns:components="clr-namespace:ClinicManagement.UI.Views.Components"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">
    <Grid Margin="10">
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="15" Background="{StaticResource CardBrush}">
            <Grid>
                <Grid Grid.Column="1" Margin="50,30">
                    <StackPanel Width="350" HorizontalAlignment="Center">
                        <TextBlock Text="Tiếp nhận bệnh nhân" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,30" FontWeight="SemiBold"/>
                        <TextBlock Text="Họ tên"/>
                        <TextBox/>
                        <TextBlock Text="Giới tính" Margin="0,15,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Nam" Margin="10,0"/>
                            <RadioButton Content="Nữ" Margin="20,0"/>
                        </StackPanel>
                        <TextBlock Text="Ngày sinh" Margin="0,15,0,5"/>
                        <TextBox/>
                        <TextBlock Text="Số điện thoại" Margin="0,15,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="240"/>
                            <Button Content="Tìm" Width="60" Margin="10,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,50,0,0">
                            <Button Content="Thêm" Style="{StaticResource PrimaryButton}" Margin="10,0"/>
                            <Button Content="Hủy" Style="{StaticResource CancelButton}" Margin="10,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
