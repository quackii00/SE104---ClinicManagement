<Page x:Class="ClinicManagement.UI.Views.UI.Report.MedicineUsageReportView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClinicManagement.UI.Views.UI.Report"
      mc:Ignorable="d" 
      d:DesignHeight="660" d:DesignWidth="800"
      Title="MedicineUsageReportView">

    <Grid>
        <Border BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="15" 
            Background="{StaticResource CardBrush}">


        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filter -->
            <StackPanel Orientation="Horizontal"
                        Margin="10">

                <TextBlock Text="Tháng:"
                           FontSize="22"
                           VerticalAlignment="Center"/>

                <DatePicker Width="130"
                            Margin="15,0"/>

                <Button Content="Lập báo cáo"
                        Style="{StaticResource PrimaryButton}"
                        Margin="30,0"
                        />
            </StackPanel>

            <!-- Table -->
            <Border Grid.Row="1"
                    Margin="0,15"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">

                <DataGrid AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Vertical"
                          CanUserAddRows="False">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="STT"
                                            Width="50"
                                            Binding="{Binding STT}"/>

                        <DataGridTextColumn Header="Thuốc"
                                            Width="200"
                                            Binding="{Binding TenThuoc}"/>

                        <DataGridTextColumn Header="Đơn vị"
                                            Width="150"
                                            Binding="{Binding DonVi}"/>

                        <DataGridTextColumn Header="Số lượng"
                                            Width="150"
                                            Binding="{Binding SoLuong}"/>

                        <DataGridTextColumn Header="Số lần dùng"
                                            Width="150"
                                            Binding="{Binding SoLanDung}"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </Grid>

        </Border>
    </Grid>
</Page>
