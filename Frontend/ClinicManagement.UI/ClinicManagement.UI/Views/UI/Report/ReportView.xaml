<UserControl x:Class="ClinicManagement.UI.Views.UI.Report.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClinicManagement.UI.Views.UI.Report"
             xmlns:views="clr-namespace:ClinicManagement.UI.Views.UI.Report"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">
    <Grid>
        <Border BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="15" 
            Background="{StaticResource CardBrush}">

            <TabControl>

            <TabControl.Resources>

                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">

                                <Border x:Name="Bd"
                                Background="White"
                                BorderBrush="#666"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20,8">

                                    <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ContentSource="Header"/>

                                </Border>

                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsSelected"
                                     Value="True">

                                        <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{StaticResource LightBlueBrush}"/>

                                        <Setter TargetName="Bd"
                                        Property="BorderThickness"
                                        Value="1,1,1,0"/>

                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

            </TabControl.Resources>

            <!-- Tab 1 -->
            <TabItem Header="Báo cáo tháng" Height="40" Width="150" >

                <views:MonthlyReportView/>

            </TabItem>

            <!-- Tab 2 -->
            <TabItem Header="Báo cáo sử dụng thuốc"  Height="40" Width="200">

                <views:MedicineUsageReportView/>

            </TabItem>

        </TabControl>
        </Border>
    </Grid>
</UserControl>
