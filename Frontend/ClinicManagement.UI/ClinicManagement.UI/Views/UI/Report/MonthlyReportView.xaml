<UserControl x:Class="ClinicManagement.UI.Views.UI.Report.MonthlyReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClinicManagement.UI.Views.UI.Report"
             mc:Ignorable="d" 
             d:DesignHeight="660" d:DesignWidth="800">
    <Grid>
        <Border BorderBrush="{StaticResource BorderBrush}" 
        BorderThickness="1" 
        CornerRadius="15" 
        Background="{StaticResource CardBrush}">

            <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Filter -->
            <StackPanel Orientation="Horizontal"
                        Margin="10">

                <TextBlock Text="Tháng:"
                           FontSize="22"
                           VerticalAlignment="Center"/>

                <DatePicker Width="130"
                            Margin="15,0"
                            SelectedDate="{Binding SelectedDate}"/>

                <Button Content="Lập báo cáo"
                        Style="{StaticResource PrimaryButton}"
                        Margin="30,0"
                        Command="{Binding LapBaoCaoCommand}"
                        />
            </StackPanel>

            <!-- Data -->
            <Border Grid.Row="1"
                    Margin="0,15"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">

                <DataGrid AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Vertical"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding ChiTiet}">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="STT"
                                            Width="50"
                                            Binding="{Binding STT}"/>

                        <DataGridTextColumn Header="Ngày"
                                            Width="150"
                                            Binding="{Binding Ngay}"/>

                        <DataGridTextColumn Header="Số bệnh nhân"
                                            Width="170"
                                            Binding="{Binding SoBenhNhan}"/>

                        <DataGridTextColumn Header="Doanh thu"
                                            Width="180"
                                            Binding="{Binding DoanhThu}"/>

                        <DataGridTextColumn Header="Tỷ lệ"
                                            Width="100"
                                            Binding="{Binding TyLe}"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

            <!-- Footer -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Margin="20,10">

                <TextBlock Text="Tổng doanh thu:"
                           VerticalAlignment="Center"/>

                <TextBox Width="150"
                         Margin="10,0"
                         IsReadOnly="True"
                         BorderBrush="{StaticResource BorderBrush}"
                         Text="{Binding TongDoanhThu, Mode=OneWay, StringFormat=N0}"/>
            </StackPanel>

        </Grid>

        </Border>
    </Grid>
</UserControl>
