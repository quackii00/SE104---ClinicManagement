<UserControl x:Class="ClinicManagement.UI.Views.UI.Examination.PatientLookupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClinicManagement.UI.Views.UI.Examination"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">
    <Grid>
        <Border BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="15" 
            Background="{StaticResource CardBrush}">

            <Grid Margin="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Search Area -->
                <StackPanel Grid.Column="0">

                    <TextBlock Text="Tra cứu bệnh nhân"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                    <TextBlock Text="Họ tên"/>
                    <TextBox Height="35"/>

                    <TextBlock Text="Số điện thoại"
                           Margin="0,10,0,0"/>
                    <TextBox Height="35"/>

                    <TextBlock Text="Loại bệnh"
                           Margin="0,10,0,0"/>
                    <ComboBox Height="35"/>

                    <TextBlock Text="Giới tính"
                           Margin="0,10,0,0"/>

                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Nam"/>
                        <RadioButton Content="Nữ"
                                 Margin="20,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="Ngày khám"
                           Margin="0,10,0,0"/>
                    <DatePicker Height="35"/>

                    <Button Content="Tìm kiếm"
                        Width="120"
                        Height="40"
                        Margin="0,30,0,0"
                        HorizontalAlignment="Center"
                        Background="{StaticResource PrimaryButtonBrush}"/>

                </StackPanel>

                <!-- Result -->
                <Border Grid.Column="1"
                    Margin="30,30,0,0"
                    Background="{StaticResource LightBlueBrush}"
                    CornerRadius="15">

                    <ListBox ItemsSource="{Binding Patients}"
                         Margin="15">

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Border Height="40"
                                    Margin="0,5"
                                    Background="White"
                                    CornerRadius="5">

                                    <TextBlock Text="{Binding FullName}"
                                           VerticalAlignment="Center"
                                           Margin="10,0"/>

                                </Border>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                </Border>

            </Grid>

        </Border>

    </Grid>
</UserControl>
