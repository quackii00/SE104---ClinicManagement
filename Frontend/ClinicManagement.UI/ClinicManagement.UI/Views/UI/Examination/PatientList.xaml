<UserControl x:Class="ClinicManagement.UI.Views.UI.Examination.PatientList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ClinicManagement.UI.Views.UI.Examination"
             xmlns:components="clr-namespace:ClinicManagement.UI.Views.Components"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="800">

    <Grid Margin="10">

        <Border BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="15"
                Background="{StaticResource CardBrush}">

            <Grid Margin="30">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->

                <TextBlock Text="Danh sách khám"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Counter -->

                <TextBlock Grid.Row="1"
                           Text="xx/Max"
                           FontSize="16"
                           Foreground="Green"
                           Margin="10,0,0,15"/>

                <!-- List -->

                <Border Grid.Row="2"
                        Width="500"
                        Height="300"
                        HorizontalAlignment="Center"
                        Padding="10"
                        CornerRadius="10"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel>

                            <components:PatientListItem/>

                            <components:PatientListItem/>

                            <components:PatientListItem/>

                            <components:PatientListItem/>

                            <components:PatientListItem/>

                        </StackPanel>

                    </ScrollViewer>

                </Border>

                <!-- Add button -->

                <Button Grid.Row="3"
                        Content="Thêm bệnh nhân"
                        Width="150"
                        Height="35"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0"
                        Style="{StaticResource PrimaryButton}"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>