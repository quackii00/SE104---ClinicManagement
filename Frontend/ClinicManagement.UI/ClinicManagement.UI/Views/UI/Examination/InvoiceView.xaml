<UserControl x:Class="ClinicManagement.UI.Views.UI.Examination.InvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClinicManagement.UI.Views.UI.Examination"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">
    <Grid>
        <Border BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="15" 
            Background="{StaticResource CardBrush}">

            <Grid Margin="25">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0"
                       Text="Hóa đơn"
                       FontSize="32"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

                <!-- Tiền khám -->
                <StackPanel Grid.Row="1"
                        Margin="10">

                    <TextBlock Text="Tiền khám"
                           FontSize="18"/>

                    <TextBox Width="260"
                         Height="40"
                         Margin="0,10,0,0"
                         IsReadOnly="True"
                         Text="{Binding ExaminationFee}"/>

                </StackPanel>

                <!-- Thuốc -->
                <StackPanel Grid.Row="2"
                        Margin="0,15,0,0">

                    <TextBlock Text="Tiền thuốc"
                           FontSize="18"
                           Margin="10"/>

                    <DataGrid ItemsSource="{Binding InvoiceMedicines}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          Height="250"
                          Margin="0,0,0,10">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Tên thuốc"
                                            Width="*"
                                            Binding="{Binding MedicineName}"/>

                            <DataGridTextColumn Header="Số lượng"
                                            Width="120"
                                            Binding="{Binding Quantity}"/>

                            <DataGridTextColumn Header="Giá"
                                            Width="150"
                                            Binding="{Binding Amount,
                                                              StringFormat=N0}"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </StackPanel>

                <!-- Tổng thuốc -->
                <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10">

                    <TextBlock Text="Tổng chi phí thuốc:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                    <TextBox Width="160"
                         Height="35"
                         IsReadOnly="True"
                         Text="{Binding TotalMedicineCost}"/>

                </StackPanel>

                <!-- Separator -->
                <Separator Grid.Row="4"
                       Margin="0,20"/>

                <!-- Tổng tiền -->
                <StackPanel Grid.Row="5">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Tổng tiền"
                               VerticalAlignment="Center"
                               FontSize="16"/>

                        <TextBox Width="160"
                             Margin="15,0"
                             IsReadOnly="True"
                             Text="{Binding TotalAmount}"/>

                    </StackPanel>

                    <Button Content="Thanh toán"
                        Width="180"
                        Height="45"
                        Margin="0,25,0,0"
                        HorizontalAlignment="Center"
                        Background="{StaticResource PrimaryButtonBrush}"
                        Command="{Binding PaymentCommand}"/>

                </StackPanel>

            </Grid>


        </Border>

    </Grid>
</UserControl>
