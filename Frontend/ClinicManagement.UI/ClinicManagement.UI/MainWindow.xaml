<Window x:Class="ClinicManagement.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:ClinicManagement.UI.Views.Components"
        xmlns:ui="clr-namespace:ClinicManagement.UI.Views.UI.Dashboard"
        xmlns:vm="clr-namespace:ClinicManagement.UI.ViewModels" 
        xmlns:exam="clr-namespace:ClinicManagement.UI.Views.UI.Examination"
        xmlns:patient="clr-namespace:ClinicManagement.UI.Views.UI.Patient"
        xmlns:report="clr-namespace:ClinicManagement.UI.Views.UI.Report"
        Title="Clinic Management"
        Height="700"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <ui:Dashboard />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PatientListViewModel}">
            <exam:PatientList />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PrescriptionViewModel}">
            <patient:PrescriptionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MedicalRecordViewModel}">
            <patient:MedicalRecord />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RecievePatientViewModel}">
            <patient:RecievePatient />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PatientLookupViewModel}">
            <exam:PatientLookupView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MedicalHistoryViewModel}">
            <exam:MedicalHistoryView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:InvoiceViewModel}">
            <exam:InvoiceView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ReportViewModel}">
            <report:ReportView />
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Border BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="15"
                ClipToBounds="True"
                Background="{StaticResource CardBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <components:Sidebar Grid.Column="0" 
                                    Width="180"
                                    VerticalAlignment="Stretch"
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>

                <ContentControl x:Name="MainContent"
                                Grid.Column="1"
                                Content="{Binding CurrentView}"/>
            </Grid>
        </Border>
    </Grid>
</Window>